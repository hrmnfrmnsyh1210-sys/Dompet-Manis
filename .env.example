# Connection string TiDB Cloud (Serverless/Starter).
# Ambil dari TiDB Cloud → cluster → Connect → pilih "Serverless Driver".
# Bagian setelah "/" adalah nama database (buat dulu databasenya di TiDB, mis. "dompet").
NUXT_DATABASE_URL=mysql://USERNAME.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/dompet

# Zona waktu untuk tanggal default transaksi dari bot (server Vercel berjalan dalam UTC)
NUXT_APP_TIMEZONE=Asia/Jakarta
